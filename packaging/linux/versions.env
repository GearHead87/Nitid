# Pinned versions of everything a Nitid release is built with. Sourced by build-deps.sh, build-release.sh
# and the GitHub workflows (cache keys). Change a version together with its SHA-256.

FFMPEG_VERSION=9.1
FFMPEG_SHA256=1a4d394ae63d190a526cd052eb4415c156b5c5e2df37efab41a7de0b8fde2433
NV_CODEC_HEADERS_VERSION=12.2.72.0   # NVDEC API 12.2: NVIDIA driver 550 or newer
NV_CODEC_HEADERS_SHA256=c295a2ba8a06434d4bdc5c2208f8a825285210d71d91d572329b2c51fd0d4d03
SDL3_VERSION=3.4.20
SDL3_SHA256=f3bb06f55bed9557227a700af2ea62e49497ebdf58037732a731a5fb3ef8581f
CLI11_VERSION=2.7.2
CLI11_SHA256=46eef3101da70852ec7af026e09d485ccee81813331c8c6052d39344443b83da

# NVIDIA VFX SDK C headers (MIT): github.com/NVIDIA-Maxine/Maxine-VFX-SDK, only nvvfx/include is used.
MAXINE_VFX_SDK_COMMIT=f12bd18929e9065cff4f24cb93ac5f4202dc1c4a

# NVIDIA DLSS SDK (NVIDIA RTX SDKs license): github.com/NVIDIA/DLSS tag v310.9.16. Only include/ and the static
# libnvsdk_ngx.a are used, for the separate DLSS module (libnitid-dlss.so). The DLSS runtime libraries are not
# shipped: users install them with nitid-setup-dlss.
DLSS_SDK_VERSION=310.9.16
DLSS_SDK_COMMIT=9981c6350dc58c0ce21f024fd65e31e851c31689
DLSS_NGX_LIB_SHA256=d3c50bb0d9624fc35e502a8e929b8fc1e2b505017ebdb84c0d5b627e11a235df

# Bump when build-deps.sh changes how the dependencies are built, so cached builds are redone.
DEPS_STAMP="ffmpeg${FFMPEG_VERSION}-nvch${NV_CODEC_HEADERS_VERSION}-sdl${SDL3_VERSION}-cli11${CLI11_VERSION}-r1"
